# ---------------------------------------------------------------------------
# GHthrift environment variables
# Copy to .env for local development: cp .env.example .env
# ---------------------------------------------------------------------------

# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
SITE_URL=http://localhost:8000

# Database. Leave unset to use SQLite locally.
# DATABASE_URL=postgres://ghthrift:password@127.0.0.1:5432/ghthrift
# DB_SSL_REQUIRE=False

# Media. Use a persistent disk or S3 in production.
# MEDIA_ROOT=/var/data/media

# S3-compatible media storage (optional; enables django-storages)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_MEDIA_LOCATION=media
# AWS_S3_CUSTOM_DOMAIN=

# Payments
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
# Allow automatic sandbox approval when Paystack keys are absent. Keep False in production.
PAYSTACK_ALLOW_MOCK=True

# Delivery
DELIVERY_FEE=30.00

# Email (SMTP). If EMAIL_HOST is empty, emails print to the console.
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GHthrift <orders@ghthrift.com>

# Security overrides (sensible production defaults are derived from DEBUG)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Used by build.sh to create the first admin on Render/VPS.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
